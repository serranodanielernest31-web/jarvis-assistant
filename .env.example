# ---------------------------------------------------------------------------
# JARVIS / FRIDAY — Assistant Console
#
# The app runs with NO environment variables: the assistant brain, the GitHub
# data and the voice transport are all local (browser APIs + fixtures).
#
# The variables below are what a REAL deployment would need once you replace
# src/lib/assistant.ts and src/data/github.ts with live calls. They are listed
# for documentation only — nothing in this repo reads them, and none of them
# may ever be exposed to the browser bundle (Vite only inlines VITE_* vars,
# so keep every secret server-side).
# ---------------------------------------------------------------------------

# --- LLM (server-side only) -------------------------------------------------
# Provider key for the planner that replaces planTurn().
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- Speech-to-text / text-to-speech (optional) -----------------------------
# Not required: the app uses the browser's SpeechRecognition + SpeechSynthesis.
# Set these only if you swap in a vendor for consistent cross-browser voice.
STT_API_KEY=
TTS_API_KEY=

# --- GitHub -----------------------------------------------------------------
# A GitHub App installation token (repo-scoped, 1h TTL) or a fine-grained PAT.
# Server-side only — never prefix with VITE_.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_TOKEN=

# --- App --------------------------------------------------------------------
# Base URL of the backend that proxies the calls above.
API_BASE_URL=http://localhost:8787
